# ==========================================
# InsightAgent - Environment Configuration
# ==========================================

# Google Gemini API Key (Required for AI Engine)
# Note: Free tier has daily request limits. For production or heavy daily use, 
# please upgrade to a paid Gemini API plan via Google AI Studio.
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Database Configuration (SQLite / Dynamic MySQL Support)
# Format for SQLite: sqlite:///./business_data.db
# Format for MySQL: mysql+pymysql://username:password@host:port/dbname
DATABASE_URL=sqlite:///./business_data.db
